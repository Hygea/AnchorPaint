{
  "name": "anchorpaint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based STL surface selection and aligned slicer modifier export",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/geometry.test.ts tests/export.test.ts tests/profile.test.ts tests/selection.test.ts",
    "test:watch": "node --watch --import tsx --test tests/geometry.test.ts tests/export.test.ts tests/profile.test.ts tests/selection.test.ts",
    "test:ui": "playwright test",
    "test:site": "playwright test --config playwright.production.config.ts",
    "spike:export": "tsx tools/export-fixtures.ts",
    "spike:inspect": "tsx tools/inspect-3mf.ts",
    "spike:verify-bambu": "tsx tools/verify-bambu.ts",
    "profile:build-default": "tsx tools/build-default-profile.ts",
    "profile:rebuild": "tsx tools/rebuild-default-profile.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "polygon-clipping": "0.15.7",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "license": "MIT AND AGPL-3.0-only"
}
